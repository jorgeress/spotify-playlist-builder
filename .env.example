# Credenciales de la app en https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# El client ID tambien se usa en el navegador para construir la URL de login
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=

# Debe coincidir con la Redirect URI registrada en el dashboard de Spotify
NEXT_PUBLIC_REDIRECT_URI=http://127.0.0.1:3000/auth/callback
